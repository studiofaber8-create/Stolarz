{
  "name": "stolarz-facebook-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "panel": "node dist/main.js",
    "panel:dev": "tsx src/main.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
