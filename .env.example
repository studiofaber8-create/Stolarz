CAMOFOX_URL=http://127.0.0.1:9377
CAMOFOX_API_KEY=replace-with-a-long-random-secret
CAMOFOX_REQUEST_TIMEOUT_MS=30000
AGENT_DATA_DIR=./data
AGENT_PROFILE_PREFIX=stolarz-fb
FACEBOOK_HOME_URL=https://www.facebook.com/
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Wymagany, jeśli PANEL_HOST nie jest adresem lokalnym.
PANEL_API_TOKEN=


# Claude Opus 4.8 przez Custom API. URL powinien wskazywać bezpośrednio endpoint messages/chat-completions.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=claude-opus-4-8
# anthropic albo openai-compatible
LLM_API_FORMAT=anthropic
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_REQUEST_TIMEOUT_MS=120000
